# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Meta Model API (https://dev.meta.ai) ---
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# Spending guard: a Meta Model API call is refused when it would push
# today's spend (UTC day) above this many US dollars.
DAILY_BUDGET_USD=5.00
# Of that cap, this much is kept for the fountaining alerts (vigil-alerts); the pipeline stops at the rest.
ALERT_RESERVE_USD=0.75
ALERTS_PATH=config/alerts.yaml

# --- Telegram (vigil-alerts posts each alert to a public channel) ---
# The bot's token from @BotFather: a secret. The channel: @username, or its numeric id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Empty: Telegram itself. Hugging Face Spaces cannot reach api.telegram.org, so the Space posts through a relay
# (docs/DEPLOY.md, "Fountaining alerts and Telegram").
TELEGRAM_API_URL=

# --- Storage ---
DATA_DIR=data
DB_PATH=data/vigil.sqlite
SOURCES_PATH=config/sources.yaml
PROMPTS_PATH=config/prompts.yaml
CALIBRATION_PATH=config/calibration.yaml

# --- Webcam polling ---
HTTP_USER_AGENT=VolcanoVigil/0.1 (volcano webcam monitor; hackathon project)
